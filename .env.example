# Transporte MCP: "stdio" (IDE/CLI local) o "streamable-http" (Docker/Cloud/LangGraph)
MCP_TRANSPORT=stdio

# Configuración HTTP (solo usada en modo streamable-http)
MCP_HOST=0.0.0.0
PORT=8000
MCP_PATH=/mcp

# Autenticación Bearer opcional para streamable-http (vacío = sin auth, solo recomendado en local)
# En producción generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=

# Fail-closed: streamable-http no arranca sin MCP_API_KEY. Solo para desarrollo local,
# poner true para permitir arrancar sin autenticación (default: false).
MCP_ALLOW_UNAUTHENTICATED=false

# Lista separada por comas de orígenes permitidos para CORS/Origin validation (vacío = sin CORS abierto)
ALLOWED_ORIGINS=

# Rutas locales
SKILLS_DIR=./skills_store
ROLES_CONFIG_PATH=./config/roles.yaml

# Montar proveedor nativo de skills de FastMCP v4.2+ (skills/list, read_skill) en paralelo
MCP_ENABLE_NATIVE_SKILLS=true

# Opcional: token solo para sync_skills.py si my_skills pasa a ser repositorio privado
GITHUB_TOKEN=

# Nivel de logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
